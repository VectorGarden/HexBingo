{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bingo.reizu.dev/goals/schema.json",
  "title": "HexBingo goal list",
  "description": "One game's goals. Files live in goals/ and are named in goals/index.json.",
  "type": "object",
  "required": ["name", "goals"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Schema version. Absent means 1.",
      "type": "integer",
      "enum": [1]
    },
    "name": {
      "description": "Shown in the game picker.",
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "description": "Shown behind a Rules button. Rendered as plain text, never as HTML.",
      "type": "array",
      "items": { "type": "string" }
    },
    "tips": {
      "description": "Appended after rules, same treatment.",
      "type": "array",
      "items": { "type": "string" }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "difficulty"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "difficulty": {
            "description": "1 Quick, 2 Easy, 3 Medium, 4 Hard, 5 Grueling.",
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "tags": {
            "description": "Goals sharing a tag are pushed apart, so one line doesn't become collect 10 / 30 / 80.",
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
