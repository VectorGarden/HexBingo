{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bingo.reizu.dev/goals/index.schema.json",
  "title": "HexBingo goal list manifest",
  "description": "Which lists exist. Loaded at boot; the list files themselves are fetched on demand.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "name"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "description": "Stable key. Appears in board URLs, so changing it breaks shared links.",
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "name": { "type": "string", "minLength": 1 },
      "file": {
        "description": "Defaults to <id>.json.",
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+\\.json$"
      }
    }
  }
}
